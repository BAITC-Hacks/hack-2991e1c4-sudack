# Copy to .env before `docker compose up`. All values are optional.
OPENAI_API_KEY=
NVIDIA_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT=9
# Frontend: "false" talks to the Go API (default), "true" runs on the bundled synthetic dataset.
FRONTEND_USE_MOCKS=false
FRONTEND_API_URL=http://localhost:8080
# AI service URL the browser may call directly in mocks mode; empty disables the AI-direct demo mode.
FRONTEND_AI_URL=http://localhost:8001
# Ordered LLM provider chain and allowed browser origins for the AI service.
LLM_PROVIDERS=openai,nvidia
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Go API: HS256 secret for role tokens and the demo login endpoint (set DEMO_AUTH=false outside the demo).
AUTH_SECRET=careerquest-local-demo-secret
DEMO_AUTH=true
